#ifndef DPC_VERSION_H
#define DPC_VERSION_H

#define DPC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define DPC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define DPC_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define DPC_STRINGIFY(x) #x
#define DPC_TOSTRING(x) DPC_STRINGIFY(x)

#define DPC_VERSION_STRING \
    DPC_TOSTRING(DPA_VERSION_MAJOR) "." \
    DPC_TOSTRING(DPA_VERSION_MINOR) "." \
    DPC_TOSTRING(DPA_VERSION_PATCH)

#endif // !DPC_VERSION_H
