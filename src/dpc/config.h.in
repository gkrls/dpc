#ifndef DPC_CONFIG_H
#define DPC_CONFIG_H

#define DPC_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define DPC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define DPC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define DPC_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define DPC_VERSION_STRING "@PROJECT_VERSION@"

#cmakedefine01 DPC_ASAN_ENABLED
#cmakedefine01 DPC_DPDK_ENABLED
#cmakedefine01 DPC_PROF_ENABLED
#cmakedefine01 DPC_TRACE_ENABLED

#cmakedefine01 DPC_AVX512_AVAILABLE
#cmakedefine01 DPC_AVX2_AVAILABLE

#endif // !DPC_CONFIG_H
