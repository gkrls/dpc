CompileFlags:
  CompilationDatabase: build/
  Add:
    - -Wno-c++20-extensions
    - -Wno-gnu-zero-variadic-macro-arguments
    - -Wno-comment
Diagnostics:
  UnusedIncludes: Strict
  # ClangTidy:
  #   Add:
  #     - bugprone-*
  #     - performance-*
  #     - modernize-*
  #     - readability-*
    # Remove:
    #   - modernize-use-trailing-return-type  # noisy
    #   - readability-magic-numbers           # noisy
Index:
  StandardLibrary: Yes
  Background: Build
Completion:
  AllScopes: true

